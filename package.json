{
  "name": "bun-backend-starter",
  "version": "1.0.0",
  "description": "Production-ready Bun backend starter: better-auth (email/password + passkeys), SQLite/Postgres, Redis cache, SSE realtime, rate limiting, uploads and API docs.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "bun-backend-starter": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example",
    "docs"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.3.10",
  "scripts": {
    "dev:all": "NODE_ENV=development bun scripts/start-dev.ts",
    "start": "NODE_ENV=production bun dist/cli.js",
    "tls:gencert": "bun scripts/gen-dev-tls.ts",
    "build": "bun scripts/rm-dist.mjs && bun build src/index.ts --outdir=dist --target=bun --packages=external && bun build src/cli.ts --outdir=dist --target=bun --packages=external --banner \"#!/usr/bin/env bun\" && bun scripts/copy-db-migrations.mjs && bunx tsc -p tsconfig.build.json && bun scripts/rewrite-types-paths.ts",
    "prepack": "bun run build",
    "test": "bun test --coverage",
    "test:watch": "bun test --watch --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "db:migrate:prd": "bun src/db/migrate-cli.ts",
    "db:migrate:dev": "bun scripts/db-sync.ts",
    "db:seed": "bun src/db/run-seed.ts",
    "standalone": "bun build --compile --minify --bytecode src/cli.ts --outfile=myapp && bun scripts/copy-standalone-migrations.mjs"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.1",
    "better-auth": "^1.7.1",
    "isbot": "^5.2.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@faker-js/faker": "^10.4.0",
    "@types/bun": "^1.3.13",
    "typescript": "^7.0.2"
  }
}
