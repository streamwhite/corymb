{
  "name": "hono-hands-on",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "dev": "NODE_ENV=development bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "start:dist": "bun dist/index.js",
    "tls:gencert": "bun scripts/gen-dev-tls.ts",
    "build": "bun scripts/rm-dist.mjs && bun build src/index.ts --outdir=dist --minify --target=bun --sourcemap=external && bun scripts/copy-db-migrations.mjs",
    "test": "bun test --coverage --concurrent",
    "test:watch": "bun test --watch --coverage --concurrent",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "db:generate": "drizzle-kit generate",
    "db:seed": "bun src/db/run-seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@faker-js/faker": "^10.4.0",
    "@types/bun": "^1.2.19",
    "@types/node": "^22.14.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.8.3"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
