{
  "name": "hono-hands-on",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "dev": "NODE_ENV=development bun --watch src/index.ts",
    "start": "NODE_ENV=production bun dist/index.js",
    "tls:gencert": "bun scripts/gen-dev-tls.ts",
    "build": "bun scripts/rm-dist.mjs && bun build src/index.ts --outdir=dist --production --target=bun && bun scripts/copy-db-migrations.mjs",
    "test": "bun test --coverage --concurrent",
    "test:watch": "bun test --watch --coverage --concurrent",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "db:migrate": "bun src/db/migrate-cli.ts",
    "db:sync": "bun scripts/db-sync.ts",
    "db:seed": "bun src/db/run-seed.ts",
    "standalone": "bun build --compile --minify --bytecode src/index.ts --outfile=myapp && bun scripts/copy-standalone-migrations.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@faker-js/faker": "^10.4.0",
    "@types/bun": "^1.2.19",
    "typescript": "^5.8.3"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
