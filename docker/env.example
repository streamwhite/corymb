# Copy this file to the project root as `.env` before `docker compose up`.
# Docker Compose loads `.env` automatically for variable substitution.
#
# JWT secret must be at least 32 bytes (application requirement in production).

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Published host port (maps to container port 3000).
HOST_PORT=3000
