# Copy to `.env` in the project root. Bun loads `.env` automatically.

# Required for Better Auth (at least 32 characters). JWT_SECRET is accepted as fallback.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Public base URL used by Better Auth (emails, redirects).
# Must match how you open the app in the browser (scheme + host + port).
# With local TLS: https://localhost:3000  (prefer localhost over 0.0.0.0)
BETTER_AUTH_URL=http://localhost:3000

# HTTP listen port (default 3000).
PORT=3000

# HTTP listen host. Defaults: localhost in development, 0.0.0.0 in production.
# HOST=localhost

# Service name attached to structured logs.
# SERVICE_NAME=my-backend

# Log level: debug | info (default) | warn | error.
# LOG_LEVEL=info

# PostgreSQL admin connection. Auth tables live in the `auth` schema; schema
# migrations also use this connection. Runtime application data goes through
# PostgREST, not this connection.
DATABASE_URL=postgres://user:pass@127.0.0.1:5432/mydb

# PostgREST data API. Exposes the `app` schema and verifies Better Auth JWTs.
POSTGREST_URL=http://127.0.0.1:3001
# PostgREST schema/profile to target (default: app).
# POSTGREST_SCHEMA=app
# Optional privileged token for server-side/admin data access. Keep secret.
# POSTGREST_SERVICE_TOKEN=
# POSTGREST_TIMEOUT_MS=10000

# CORS allowlist for browser clients (comma separated origins).
# Empty disables CORS. Use * to allow any origin (do not combine with credentials).
# CORS_ORIGINS=https://app.example.com
# CORS_CREDENTIALS=true

# Cache backend: redis (default) | memory (process-local LRU, no Redis needed).
# CACHE_DRIVER=redis

# Redis (required when CACHE_DRIVER=redis, for secondary storage / cache).
# VALKEY_URL is accepted as an alias when REDIS_URL is unset.
REDIS_URL=redis://127.0.0.1:6379
# VALKEY_URL=redis://127.0.0.1:6379
# CACHE_KEY_PREFIX=ba:
# CACHE_USER_TTL_SECONDS=300
# CACHE_SESSION_TTL_SECONDS=300

# In-memory LRU cache tuning (used when CACHE_DRIVER=memory).
# MEMORY_CACHE_MAX_ITEMS=5000
# MEMORY_CACHE_TTL_SECONDS=300

# Upload directory / default filesystem storage root (default data/uploads).
# UPLOAD_DIR=data/uploads

# Object storage. Default driver: filesystem. Use s3 for S3-compatible services
# (AWS S3, Cloudflare R2, MinIO, ...). Credentials fall back to Bun's AWS env.
# STORAGE_DRIVER=filesystem     # filesystem | s3 | memory
# S3_BUCKET=my-bucket
# S3_REGION=us-east-1
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Idempotency: protect retry-prone mutating paths by requiring Idempotency-Key.
# IDEMPOTENCY_TTL_SECONDS=86400

# Background jobs (BullMQ + Redis): graceful shutdown drain timeout.
# SHUTDOWN_TIMEOUT_MS=15000

# Passkey (WebAuthn). Defaults derive from BETTER_AUTH_URL (rpID=hostname, origin=scheme://host[:port]).
# Override only if the browser origin differs from BETTER_AUTH_URL. Production must be HTTPS.
# BETTER_AUTH_PASSKEY_RP_ID=localhost
# BETTER_AUTH_PASSKEY_ORIGIN=http://localhost:3000
# MAX_PASSKEYS_PER_USER=5

# Two-factor (email OTP). Codes are sent via the configured mailer.
# TWO_FACTOR_OTP_DIGITS=6
# TWO_FACTOR_OTP_PERIOD_MINUTES=3
# TWO_FACTOR_OTP_ATTEMPTS=5

# Two-factor (TOTP / authenticator apps). Shown as the issuer in authenticators.
# TWO_FACTOR_ISSUER=Backend Template
# TWO_FACTOR_TOTP_DIGITS=6          # 6 | 8
# TWO_FACTOR_TOTP_PERIOD_SECONDS=30

# Optional session / JWT tuning
# ACCESS_JWT_EXPIRATION=15m
# SESSION_EXPIRES_IN_SECONDS=604800
# SESSION_UPDATE_AGE_SECONDS=86400
# COOKIE_CACHE_MAX_AGE_SECONDS=300

# Sensitive-operation step-up (re-authentication)
# SESSION_FRESH_AGE_SECONDS=3600   # sessions older than this need re-auth for sensitive ops
# SENSITIVE_VERIFY_TTL_SECONDS=300 # how long an explicit password re-check stays valid

# Mail (default driver: console)
# MAILER_DRIVER=console
# MAILER_DRIVER=noop
# MAIL_FROM=no-reply@example.com
# APP_PUBLIC_BASE_URL=http://localhost:3000

# Rate limits (max requests per client per 60s window), enforced with
# rate-limiter-flexible. With REDIS_URL set, counters are atomic and shared
# across replicas; otherwise an in-memory limiter is used (single instance).
# RATE_LIMIT_STRICT_MAX=10
# RATE_LIMIT_STANDARD_MAX=60
# RATE_LIMIT_RELAXED_MAX=300
# RATE_LIMIT_KEY_PREFIX=rl

# Bot detection (User-Agent based, see docs/bot-detection.md)
# BOT_DETECTION_MODE=block        # block (default) | log | off
# BOT_BLOCK_EXTRA=                # extra blocked tokens, comma/space separated
# BOT_ALLOW_EXTRA=                # tokens to always allow (overrides block list)

# Dev TLS (only when NODE_ENV=development and both paths exist)
# TLS_CERT_PATH=./certs/localhost.pem
# TLS_KEY_PATH=./certs/localhost-key.pem

# Optional override for SQL migrations folder
# MIGRATIONS_FOLDER=

# Password hashing cost (bcrypt)
# BCRYPT_COST=12
