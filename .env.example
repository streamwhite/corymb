# Copy to `.env` in the project root. Bun loads `.env` automatically.

# Required in production (at least 32 bytes).
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# HTTP listen port (default 3000).
PORT=3000

# Redis (required at app startup).
REDIS_URL=redis://127.0.0.1:6379

# SQLite database file (default data/items.sqlite).
# SQLITE_PATH=data/items.sqlite

# Upload directory (default data/uploads).
# UPLOAD_DIR=data/uploads
