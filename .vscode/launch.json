{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "bun",
      "request": "launch",
      "name": "Server: debug",
      "program": "${workspaceFolder}/src/index.ts",
      "cwd": "${workspaceFolder}",
      "env": { "NODE_ENV": "development" },
      "watchMode": false,
      "stopOnEntry": false
    },
    {
      "type": "bun",
      "request": "launch",
      "name": "Server: debug + hot (recommended)",
      "program": "${workspaceFolder}/src/index.ts",
      "cwd": "${workspaceFolder}",
      "env": { "NODE_ENV": "development" },
      "watchMode": "hot",
      "stopOnEntry": false
    },
    {
      "type": "bun",
      "request": "attach",
      "name": "Attach to Bun (terminal: bun --inspect …)",
      "url": "ws://localhost:6499/"
    }
  ]
}
